# ============================================================
# DEEP6 AI Chart Copilot — Environment Variables
# ============================================================
# Copy this file to deep6/.env and fill in your values.
# The copilot loads deep6/.env automatically on startup.
# ============================================================

# ------------------------------------------------------------
# Required
# ------------------------------------------------------------

# Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ------------------------------------------------------------
# Optional — External APIs
# ------------------------------------------------------------

# Massive.com options flow API key (https://massive.com)
# Also accepted as FLASHALPHA_API_KEY for legacy compatibility.
# Without this, the options flow adapter returns empty snapshots.
MASSIVE_API_KEY=your-massive-api-key-here

# ------------------------------------------------------------
# Copilot Settings (all have defaults — only set to override)
# ------------------------------------------------------------

# Claude model used for narrative generation (text-only, runs every 15s)
# Default: claude-3-5-sonnet-latest
CLAUDE_NARRATIVE_MODEL=claude-3-5-sonnet-latest

# Claude model used for chart vision analysis (screenshot, runs every 30s)
# Default: claude-3-5-sonnet-latest
CLAUDE_VISION_MODEL=claude-3-5-sonnet-latest

# How often to capture and analyze a screenshot (seconds)
# Default: 30
COPILOT_SCREENSHOT_INTERVAL_SEC=30

# How often to generate a new narrative update (seconds)
# Default: 15
COPILOT_NARRATIVE_INTERVAL_SEC=15

# Maximum tokens consumed per hour across all Claude calls.
# The copilot throttles requests when approaching this limit.
# Default: 500000
COPILOT_TOKEN_BUDGET_PER_HOUR=500000

# Which side of the screen the overlay appears on: left or right
# Default: right
COPILOT_OVERLAY_SIDE=right

# Overlay panel width in pixels
# Default: 400
COPILOT_OVERLAY_WIDTH=400

# ------------------------------------------------------------
# Data Adapters (set to false to disable individual sources)
# ------------------------------------------------------------

# Economic calendar events (e.g. CPI, FOMC, NFP)
# Default: true
COPILOT_CALENDAR_ENABLED=true

# Market news headlines
# Default: true
COPILOT_NEWS_ENABLED=true

# Market sentiment indicators
# Default: true
COPILOT_SENTIMENT_ENABLED=true

# Market internals (breadth, TICK, ADD, etc.)
# Default: true
COPILOT_INTERNALS_ENABLED=true

# Options flow from Massive.com (requires MASSIVE_API_KEY)
# Default: true
COPILOT_OPTIONS_FLOW_ENABLED=true

# ------------------------------------------------------------
# DEEP6 Infrastructure
# ------------------------------------------------------------

# TCP host for the DEEP6 data bridge (signal scores, DOM state)
# Default: 127.0.0.1
COPILOT_DATA_BRIDGE_HOST=127.0.0.1

# TCP port for the DEEP6 data bridge
# Default: 9200
COPILOT_DATA_BRIDGE_PORT=9200

# FastAPI host for the DEEP6 REST API
# Default: 127.0.0.1
COPILOT_API_HOST=127.0.0.1

# FastAPI port for the DEEP6 REST API
# Default: 8765
COPILOT_API_PORT=8765
