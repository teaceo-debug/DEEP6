# DEEP6 environment example
#
# Important:
# This file documents common backend/reference runtime variables only.
# The project still has multiple runtime surfaces, so treat these as a starting point,
# not as proof that every subsystem is fully unified yet.
#
# For current project truth, read:
# - README.md
# - docs/CURRENT-STATE.md
# - docs/VERIFICATION-LADDER.md

# -----------------------------------------------------------------------------
# Core runtime selection
# -----------------------------------------------------------------------------

# Reference runtime data source:
# - databento  = reference/live-like Python feed path
# - rithmic    = direct Rithmic path where available
DEEP6_DATA_SOURCE=databento

# Backend host/port used by the Python API/runtime surface.
DEEP6_API_HOST=127.0.0.1
DEEP6_API_PORT=8765

# SQLite/session persistence path
DEEP6_DB_PATH=./deep6_session.db

# -----------------------------------------------------------------------------
# Rithmic (see .claude/skills/rithmic-networking/knowledge.md for full reference)
# -----------------------------------------------------------------------------

# Credentials (get from broker)
RITHMIC_USER=<set-me>
RITHMIC_PASSWORD=<set-me>

# System name — CASE-SENSITIVE. Must match broker exactly.
# Common values: Apex, TopstepTrader, Bulenox, Earn2Trade, Tradeify,
#   Rithmic Test, Rithmic Paper Trading, Rithmic 01
RITHMIC_SYSTEM_NAME=Rithmic Test

# WebSocket gateway (R|Protocol)
# Chicago (default):  wss://rprotocol.rithmic.com:443
# NYC:                wss://rprotocol-nyc.rithmic.com:443
# Colo 75 (CME):      wss://rprotocol-colo75.rithmic.com:443
# Frankfurt:          wss://rprotocol-de.rithmic.com:443
# Test environment:   wss://rituz00100.rithmic.com:443
RITHMIC_URI=wss://rituz00100.rithmic.com:443

# Instrument
RITHMIC_INSTRUMENT=NQM6
RITHMIC_EXCHANGE=CME

# App identity (for Rithmic conformance)
RITHMIC_APP_NAME=migo:DEEP6
RITHMIC_APP_VERSION=2.0

# -----------------------------------------------------------------------------
# Databento
# -----------------------------------------------------------------------------

DATABENTO_API_KEY=<set-me>
DATABENTO_API_KEY_GLBX=<set-me>

# -----------------------------------------------------------------------------
# Optional market/context providers
# -----------------------------------------------------------------------------

POLYGON_API_KEY=<set-me>
FLASHALPHA_API_KEY=<set-me>
MASSIVE_API_KEY=<set-me>

# -----------------------------------------------------------------------------
# Dashboard examples
# -----------------------------------------------------------------------------
# The dashboard has its own frontend environment variables.
# Set these in dashboard/.env.local or the shell used to start the frontend.
#
# Demo mode:
# NEXT_PUBLIC_DEMO_MODE=true
#
# Backend-connected mode (example using port 8765):
# NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_API_BASE=http://localhost:8765
# NEXT_PUBLIC_WS_URL=ws://localhost:8765/ws/live

# -----------------------------------------------------------------------------
# AI Chart Copilot
# -----------------------------------------------------------------------------

# Anthropic API key for Claude (narrative model + vision model)
ANTHROPIC_API_KEY=sk-ant-<set-me>

# Claude model overrides (optional — defaults shown)
# CLAUDE_NARRATIVE_MODEL=claude-3-5-sonnet-latest
# CLAUDE_VISION_MODEL=claude-3-5-sonnet-latest

# Screenshot interval in seconds (default: 30)
COPILOT_SCREENSHOT_INTERVAL_SEC=30

# Narrative generation interval in seconds (default: 15)
COPILOT_NARRATIVE_INTERVAL_SEC=15

# Maximum Claude API tokens per hour (default: 500000)
COPILOT_TOKEN_BUDGET_PER_HOUR=500000

# Overlay side: "left" or "right" (default: right)
COPILOT_OVERLAY_SIDE=right

# Overlay width in pixels (default: 400)
COPILOT_OVERLAY_WIDTH=400

# DataBridge connection (default: 127.0.0.1:9200)
COPILOT_DATA_BRIDGE_HOST=127.0.0.1
COPILOT_DATA_BRIDGE_PORT=9200

# FastAPI WebSocket (default: 127.0.0.1:8765)
COPILOT_API_HOST=127.0.0.1
COPILOT_API_PORT=8765

# Data source toggles (all default: true)
COPILOT_CALENDAR_ENABLED=true
COPILOT_NEWS_ENABLED=true
COPILOT_SENTIMENT_ENABLED=true
COPILOT_INTERNALS_ENABLED=true
COPILOT_OPTIONS_FLOW_ENABLED=true

# ─── Confluence System (port 8767 — standalone, separate from deep6:8765 and nq_atlas:8766) ──
CONFLUENCE_PORT=8767
CONFLUENCE_W_DP=0.40
CONFLUENCE_W_GEX=0.25
CONFLUENCE_W_REGIME=0.20
CONFLUENCE_W_MTF=0.15
REFRESH_GEX_SEC=300
REFRESH_MASSIVE_SEC=15
REFRESH_REGIME_SEC=900

# ─── Equilibrium Model (companion to Confluence System) ───────────────────────────────────────
EQM_W_WEEKLY=0.50
EQM_W_DAILY=0.35
EQM_W_HVL=0.15
EQM_SIGMA_ZONE=1.5
EQM_SIGMA_EXTREME=2.5
EQM_NDX_NQ_RATIO=1.06
EQM_USE_QQQ_DAILY=true
REFRESH_EQUILIBRIUM_SEC=60
