# GEX Doctor v2.0 — Environment Configuration
# Copy to .env.gex_terminal and fill in your API keys

# === API Keys ===
# FlashAlpha API key (Growth tier, $299/mo) — https://flashalpha.com
GEX_TERMINAL_FLASHALPHA_API_KEY=

# Massive.com API key (Advanced tier, $999/mo) — https://massive.com
GEX_TERMINAL_MASSIVE_API_KEY=

# Unusual Whales API key (Phase 2) — https://unusualwhales.com
GEX_TERMINAL_UW_API_KEY=

# Anthropic API key for Claude interpretation — https://console.anthropic.com
GEX_TERMINAL_ANTHROPIC_API_KEY=

# === Server ===
# Port for the GEX Terminal backend (default: 8780)
GEX_TERMINAL_SERVER_PORT=8780

# Data refresh interval in seconds (default: 30)
GEX_TERMINAL_REFRESH_INTERVAL_SEC=30

# === Integration ===
# DEEP6 bias engine URL for bidirectional integration
GEX_TERMINAL_DEEP6_BIAS_URL=http://localhost:8765

# === Claude ===
# Claude model for narrative interpretation (haiku = cheapest, adequate for structured GEX analysis)
GEX_TERMINAL_CLAUDE_MODEL=claude-haiku-4-5-20251001

# Daily Claude API budget ceiling in USD (auto-throttles when exceeded)
GEX_TERMINAL_CLAUDE_BUDGET_DAILY_USD=10.0

# === Logging ===
# Log level: DEBUG, INFO, WARNING, ERROR
GEX_TERMINAL_LOG_LEVEL=INFO
