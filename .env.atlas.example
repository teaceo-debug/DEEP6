# NQ ATLAS Configuration
# Copy to .env.atlas and fill in your values

# Required: Massive.com API key (https://massive.com)
NQ_ATLAS_MASSIVE_API_KEY=your_massive_api_key_here

# Required: Anthropic API key for Claude AI interpretation
NQ_ATLAS_ANTHROPIC_API_KEY=sk-ant-your_key_here

# Claude model (claude-haiku-4-5-20251001 = fast+cheap, claude-sonnet-4-6 = smarter)
NQ_ATLAS_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Options chain polling cadence in seconds (10 = fast, 30 = moderate)
NQ_ATLAS_REFRESH_INTERVAL_SEC=10

# AI interpretation cadence in seconds
NQ_ATLAS_AI_REFRESH_SEC=15

# FastAPI server host and port (8766 avoids conflict with DEEP6 on 8765)
NQ_ATLAS_HOST=0.0.0.0
NQ_ATLAS_PORT=8766

# Primary underlying for options chain (QQQ only in v1)
NQ_ATLAS_UNDERLYING=QQQ

# Minimum open interest filter — strikes below this are excluded
NQ_ATLAS_MIN_OI=100

# Log level: DEBUG, INFO, WARNING, ERROR
NQ_ATLAS_LOG_LEVEL=INFO
